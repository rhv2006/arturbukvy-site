---
// Опросник: Яндекс Форма во встроенном окне. Вопросы меняются в самих Яндекс Формах —
// сайт пересобирать не нужно. embed.js от Яндекса подгоняет высоту окна под форму.
import '@fontsource-variable/unbounded';
import '@fontsource-variable/manrope';
import '../styles/global.css';

const FORM_ID = '6b06b084de8ec3603eeefba0';
const formUrl = `https://forms.yandex.ru/u/${FORM_ID}/`;
const title = 'Опросник — артурбуквы';
---

<!doctype html>
<html lang="ru">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="dark" />
    <meta name="theme-color" content="#0b0b0d" />
    <title>{title}</title>
    <meta name="robots" content="noindex" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="canonical" href={new URL('/oprosnik/', Astro.site)} />
    <!-- Yandex.Metrika counter -->
    <script is:inline type="text/javascript">
      (function(m,e,t,r,i,k,a){
          m[i]=m[i]||function(){(m[i].a=m[i].a||[]).push(arguments)};
          m[i].l=1*new Date();
          for (var j = 0; j < document.scripts.length; j++) {if (document.scripts[j].src === r) { return; }}
          k=e.createElement(t),a=e.getElementsByTagName(t)[0],k.async=1,k.src=r,a.parentNode.insertBefore(k,a)
      })(window, document,'script','https://mc.yandex.ru/metrika/tag.js?id=114661416', 'ym');

      ym(114661416, 'init', {ssr:true, webvisor:true, clickmap:true, referrer: document.referrer, url: location.href, accurateTrackBounce:true, trackLinks:true});
    </script>
    <!-- /Yandex.Metrika counter -->
  </head>
  <body>
    <main class="op">
      <a class="op-home" href="/">← артурбуквы</a>
      <h1 class="op-title">Опросник</h1>
      <div class="op-card">
        <iframe
          src={`${formUrl}?iframe=1`}
          name={`ya-form-${FORM_ID}`}
          title="Опросник"
          frameborder="0"
          loading="eager"></iframe>
      </div>
      <p class="op-alt">
        Форма не загрузилась? <a href={formUrl} target="_blank" rel="noopener">Открыть её отдельно ↗</a>
      </p>
    </main>
    <script is:inline src="https://yastatic.net/s3/cloud/forms/_/embed.js"></script>
  </body>
</html>

<style>
  .op {
    width: min(760px, 100%);
    margin-inline: auto;
    padding: 32px 16px 64px;
  }

  .op-home {
    display: inline-block;
    font-family: var(--display);
    font-size: 15px;
    color: var(--muted);
    transition: color 0.2s;
  }

  .op-home:hover {
    color: var(--accent);
  }

  .op-title {
    margin: 40px 0 28px;
    font-size: clamp(40px, 8vw, 72px);
  }

  .op-card {
    overflow: hidden;
    border-radius: var(--radius);
    background: var(--surface);
  }

  .op-card iframe {
    display: block;
    width: 100%;
    height: 900px; /* до того, как embed.js подставит точную высоту */
    border: 0;
  }

  .op-alt {
    margin-top: 16px;
    font-size: 14px;
    color: var(--muted);
  }

  .op-alt a {
    color: var(--accent);
  }
</style>
