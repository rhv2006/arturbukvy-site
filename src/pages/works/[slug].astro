---
// Страница кейса: модули проекта Behance в том же порядке, на холсте с фоном и отступами проекта.
import '@fontsource-variable/unbounded';
import '@fontsource-variable/manrope';
import '../../styles/global.css';
import { getImage } from 'astro:assets';
import Contact from '../../components/Contact.astro';
import Cursor from '../../components/Cursor.astro';
import SmoothScroll from '../../components/SmoothScroll.astro';
import cases from '../../data/cases.json';
import { projects, projectPath, vimeoThumb, type Project, type ProjectImage } from '../../lib/projects';

export function getStaticPaths() {
  return projects.map((project) => ({ params: { slug: project.slug }, props: { project } }));
}

const { project } = Astro.props as { project: Project };
const meta = (cases.cases as Record<string, { title?: string; tag?: string }>)[project.id] ?? {};
const title = meta.title ?? project.title;

// Исходник с Behance → WebP нескольких ширин на нашем домене. GIF оставляем как есть.
const WIDTHS = [700, 1400, 2800];
async function pic(img: ProjectImage) {
  if (img.gif || !img.height) return { src: img.src, srcset: undefined, width: img.width, height: img.height };
  try {
    // основной src тоже не шире 2800: исходники бывают по 10 000 px
    const w = Math.min(img.width, 2800);
    const h = Math.round((img.height * w) / img.width);
    const widths = WIDTHS.filter((x) => x < w).concat(w);
    const r = await getImage({ src: img.src, width: w, height: h, format: 'webp', quality: 88, widths });
    return { src: r.src, srcset: r.srcSet.attribute, width: img.width, height: img.height };
  } catch (err) {
    console.warn(`[project ${project.id}] ${(err as Error).message} — картинка с Behance как есть`);
    return { src: img.src, srcset: undefined, width: img.width, height: img.height };
  }
}

const modules = await Promise.all(
  project.modules.map(async (m) => {
    if (m.type === 'image') return { ...m, pic: await pic(m) };
    if (m.type === 'grid') return { ...m, pics: await Promise.all(m.images.map(pic)) };
    if (m.type === 'vimeo') return { ...m, thumb: await vimeoThumb(m.id) };
    if (m.type === 'youtube') return { ...m, thumb: `https://i.ytimg.com/vi/${m.id}/maxresdefault.jpg` };
    return m;
  }),
);

const firstImage = modules.find((m) => m.type === 'image');
const ogImage = firstImage && 'pic' in firstImage ? new URL(firstImage.pic.src, Astro.site).href : undefined;
const description = project.description || `${title} — кейс Артура Фаттахова, ${meta.tag ?? '3D и motion'}.`;
const sizes = `(min-width: ${project.canvas.width}px) ${project.canvas.width}px, 100vw`;
---

<!doctype html>
<html lang="ru">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="dark" />
    <meta name="theme-color" content="#0b0b0d" />
    <title>{`${title} — артурбуквы`}</title>
    <meta name="description" content={description} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="canonical" href={new URL(projectPath(project), Astro.site)} />
    <meta property="og:type" content="article" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {ogImage && <meta property="og:image" content={ogImage} />}
    {modules.some((m) => m.type === 'vimeo') && <link rel="preconnect" href="https://player.vimeo.com" />}
    {modules.some((m) => m.type === 'youtube') && <link rel="preconnect" href="https://www.youtube-nocookie.com" />}
    <!-- Yandex.Metrika counter -->
    <script is:inline type="text/javascript">
      (function(m,e,t,r,i,k,a){
          m[i]=m[i]||function(){(m[i].a=m[i].a||[]).push(arguments)};
          m[i].l=1*new Date();
          for (var j = 0; j < document.scripts.length; j++) {if (document.scripts[j].src === r) { return; }}
          k=e.createElement(t),a=e.getElementsByTagName(t)[0],k.async=1,k.src=r,a.parentNode.insertBefore(k,a)
      })(window, document,'script','https://mc.yandex.ru/metrika/tag.js?id=114661416', 'ym');

      ym(114661416, 'init', {ssr:true, webvisor:true, clickmap:true, referrer: document.referrer, url: location.href, accurateTrackBounce:true, trackLinks:true});
    </script>
    <!-- /Yandex.Metrika counter -->
  </head>
  <body>
    <main class="case" style={`--canvas-w: ${project.canvas.width}px`}>
      <header class="case-head">
        <a class="case-back" href="/#work">← Все работы</a>
        <h1 class="case-title">{title}</h1>
      </header>

      <div
        class="case-canvas"
        style={[
          `--canvas-w: ${project.canvas.width}px`,
          `--canvas-bg: ${project.canvas.background ?? 'transparent'}`,
          `--canvas-pad: ${project.canvas.paddingTop ?? 0}px`,
          `--canvas-text: ${project.canvas.textColor ?? '#696969'}`,
          `--canvas-link: ${project.canvas.linkColor ?? '#1769FF'}`,
        ].join('; ')}>
        {
          modules.map((m, i) => {
            const eager = i === 0;
            switch (m.type) {
              case 'image':
                return (
                  <figure class:list={['case-module', { 'is-full': m.fullBleed }]}>
                    <img
                      src={m.pic.src}
                      srcset={m.pic.srcset}
                      sizes={sizes}
                      width={m.pic.width}
                      height={m.pic.height}
                      alt=""
                      loading={eager ? 'eager' : 'lazy'}
                      decoding="async"
                    />
                    {m.caption && <figcaption>{m.caption}</figcaption>}
                  </figure>
                );
              case 'grid':
                return (
                  <figure class="case-module case-grid">
                    {m.pics.map((p) => (
                      <img src={p.src} srcset={p.srcset} sizes="50vw" width={p.width} height={p.height} alt="" loading="lazy" decoding="async" />
                    ))}
                    {m.caption && <figcaption>{m.caption}</figcaption>}
                  </figure>
                );
              case 'vimeo':
              case 'youtube':
                return (
                  <div
                    class:list={['case-module', 'case-video', { 'is-full': m.fullBleed }]}
                    style={`aspect-ratio: ${m.width} / ${m.height}`}
                    data-video={m.type}
                    data-id={m.id}>
                    {m.thumb && <img src={m.thumb} alt="" loading={eager ? 'eager' : 'lazy'} decoding="async" />}
                  </div>
                );
              case 'loop':
                return (
                  <div class:list={['case-module', { 'is-full': m.fullBleed }]}>
                    <video
                      class="case-loop"
                      data-src={m.src}
                      width={m.width}
                      height={m.height}
                      muted
                      loop
                      playsinline
                      preload="none"
                      aria-hidden="true"
                    />
                  </div>
                );
              case 'embed':
                return (
                  <div
                    class:list={['case-module', 'case-embed', { 'is-full': m.fullBleed }]}
                    style={`max-width: ${m.width}px; aspect-ratio: ${m.width} / ${m.height}`}>
                    <iframe src={m.src} title="Видео" loading="lazy" allow="autoplay; fullscreen" allowfullscreen />
                  </div>
                );
              case 'text':
                return <div class="case-module case-text" set:html={m.html} />;
            }
          })
        }
      </div>

      <Contact />
    </main>

    <footer class="wrap footer">
      <span>© {new Date().getFullYear()} Артур Фаттахов</span>
      <a href="/">артурбуквы.рф</a>
    </footer>

    <Cursor />
    <SmoothScroll />

    <script>
      // Пустые поля слева и справа от кейса: клик возвращает к работам на главной,
      // курсор показывает подсказку «← На главную».
      // запоминаем кейс: вернувшись на главную, лента встанет на него
      try {
        sessionStorage.setItem('work-last', location.pathname);
      } catch {}
      const page = document.querySelector<HTMLElement>('.case')!;
      const canvasEl = document.querySelector<HTMLElement>('.case-canvas')!;
      const BACK = '← На главную';
      const inSide = (e: MouseEvent) => {
        if (e.target !== page) return false;
        const r = canvasEl.getBoundingClientRect();
        return e.clientX < r.left || e.clientX > r.right;
      };
      page.addEventListener('pointermove', (e) => {
        if (inSide(e)) page.dataset.cursor = BACK;
        else delete page.dataset.cursor;
      });
      page.addEventListener('pointerleave', () => delete page.dataset.cursor);
      page.addEventListener('click', (e) => {
        if (inSide(e) && !String(getSelection() ?? '')) location.href = '/#work';
      });

      // Vimeo и YouTube: плеер вставляется, когда видео подходит к экрану, и играет сам, без звука,
      // по кругу — как на Behance. Поверх видео прозрачный слой: над ним остаётся наш курсор, клик
      // включает и выключает звук. Нижняя полоса с панелью плеера открыта — там системный курсор и кнопки.
      const VIMEO = 'https://player.vimeo.com';
      const YOUTUBE = 'https://www.youtube-nocookie.com';
      const SOUND_ON = 'Включить звук', SOUND_OFF = 'Выключить звук';
      const send = (frame: HTMLIFrameElement, method: string, value?: unknown) =>
        frame.contentWindow?.postMessage(JSON.stringify(value === undefined ? { method } : { method, value }), VIMEO);
      const yt = (frame: HTMLIFrameElement, func: string, args: unknown[] = []) =>
        frame.contentWindow?.postMessage(JSON.stringify({ event: 'command', func, args }), YOUTUBE);
      const cursorEl = document.querySelector<HTMLElement>('.cursor');
      const srcFor = (kind: string, id: string) =>
        kind === 'youtube'
          ? `${YOUTUBE}/embed/${id}?autoplay=1&mute=1&loop=1&playlist=${id}&playsinline=1&rel=0&modestbranding=1&vq=hd2160&enablejsapi=1&origin=${encodeURIComponent(location.origin)}`
          : `${VIMEO}/video/${id}?autoplay=1&muted=1&loop=1&autopause=0&playsinline=1&badge=0&byline=0&title=0&portrait=0&dnt=1`;

      const mount = (box: HTMLElement) => {
        const kind = box.dataset.video!;
        const frame = document.createElement('iframe');
        frame.src = srcFor(kind, box.dataset.id!);
        frame.allow = 'autoplay; fullscreen; picture-in-picture; encrypted-media';
        frame.title = 'Видео';
        frame.addEventListener('load', () => box.classList.add('is-ready'), { once: true });
        // YouTube без звука стартует в низком качестве — просим самое высокое, пока плеер раскачивается
        if (kind === 'youtube')
          frame.addEventListener(
            'load',
            () => {
              frame.contentWindow?.postMessage(JSON.stringify({ event: 'listening' }), YOUTUBE);
              for (const t of [300, 1500, 4000]) setTimeout(() => yt(frame, 'setPlaybackQuality', ['highres']), t);
            },
            { once: true },
          );

        const hit = document.createElement('button');
        hit.type = 'button';
        hit.className = 'case-video-hit';
        hit.setAttribute('aria-label', SOUND_ON);
        hit.dataset.cursor = SOUND_ON;
        let muted = true;
        const setMuted = (m: boolean) => {
          muted = m;
          const text = m ? SOUND_ON : SOUND_OFF;
          hit.dataset.cursor = text;
          hit.setAttribute('aria-label', text);
          const label = cursorEl?.querySelector('.cursor-label');
          if (label && cursorEl!.classList.contains('is-label') && hit.matches(':hover')) label.textContent = text;
        };
        hit.addEventListener('click', () => {
          if (kind === 'youtube') {
            yt(frame, muted ? 'unMute' : 'mute');
            yt(frame, 'playVideo');
          } else {
            send(frame, 'setMuted', !muted);
            if (muted) send(frame, 'setVolume', 1); // включаем звук — громкость на максимум
            send(frame, 'play');
          }
          setMuted(!muted);
        });
        // ушли со слоя вниз, на панель плеера: наш курсор прячем, а слой убираем целиком,
        // чтобы кнопки и всплывающие меню плеера (настройки, полный экран) нажимались.
        // Слой возвращается, когда мышь выйдет из видео (документ снова получит pointermove).
        hit.addEventListener('pointerleave', (e) => {
          const r = box.getBoundingClientRect();
          if (!(e.clientX > r.left && e.clientX < r.right && e.clientY > r.top && e.clientY < r.bottom)) return;
          cursorEl?.classList.remove('is-visible');
          hit.style.pointerEvents = 'none';
          setTimeout(() => {
            const restore = (ev: PointerEvent) => {
              if (ev.target instanceof Node && box.contains(ev.target)) return;
              hit.style.pointerEvents = '';
              removeEventListener('pointermove', restore);
            };
            addEventListener('pointermove', restore);
          });
        });
        // звук переключили кнопкой самого плеера — подпись на курсоре подстраивается
        addEventListener('message', (e) => {
          if (e.origin !== VIMEO || e.source !== frame.contentWindow) return;
          let data: { event?: string; data?: { volume?: number; muted?: boolean } };
          try {
            data = typeof e.data === 'string' ? JSON.parse(e.data) : e.data;
          } catch {
            return;
          }
          if (data.event === 'ready') send(frame, 'addEventListener', 'volumechange');
          if (data.event === 'volumechange') setMuted(!!data.data?.muted || data.data?.volume === 0);
        });
        box.append(frame, hit);
      };
      const boxes = document.querySelectorAll<HTMLElement>('[data-video]');
      if ('IntersectionObserver' in window) {
        const io = new IntersectionObserver(
          (entries) => {
            for (const e of entries) {
              if (!e.isIntersecting) continue;
              io.unobserve(e.target);
              mount(e.target as HTMLElement);
            }
          },
          { rootMargin: '300px 0px' },
        );
        boxes.forEach((b) => io.observe(b));
      } else {
        boxes.forEach(mount);
      }

      // Бывшие GIF: mp4 грузится, когда подходит к экрану, и играет только на экране.
      const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
      const loopIo = new IntersectionObserver(
        (entries) =>
          entries.forEach(({ target, isIntersecting }) => {
            const v = target as HTMLVideoElement;
            if (!v.src) v.src = v.dataset.src!;
            if (isIntersecting && !reduce) v.play().catch(() => {});
            else v.pause();
          }),
        { rootMargin: '300px 0px' },
      );
      document.querySelectorAll<HTMLVideoElement>('video.case-loop').forEach((v) => loopIo.observe(v));
    </script>
  </body>
</html>

<style>
  .case {
    padding: 32px 0 64px;
  }

  .case[data-cursor] {
    cursor: pointer;
  }

  /* шапка по ширине холста кейса; уже холста — с полями 16px */
  .case-head {
    width: min(var(--canvas-w, 1400px), 100% - 32px);
    margin-inline: auto;
  }

  .case-back {
    display: inline-block;
    font-family: var(--display);
    font-size: 15px;
    color: var(--muted);
    transition: color 0.2s;
  }

  .case-back:hover {
    color: var(--accent);
  }

  .case-title {
    margin: 40px 0;
    font-size: clamp(36px, 7vw, 72px);
  }
  /* узкие телефоны: длинные слова вроде «Анимированный» должны целиком влезать в строку */
  @media (max-width: 480px) {
    .case-title {
      font-size: clamp(26px, 8.4vw, 36px);
    }
  }

  /* картинки и видео идут встык, без белых полос между ними */
  .case-canvas {
    display: flex;
    flex-direction: column;
    padding-top: var(--canvas-pad);
    width: min(var(--canvas-w), 100%);
    margin-inline: auto;
    background: var(--canvas-bg);
    overflow: hidden;
  }

  @media (min-width: 768px) {
    .case-canvas {
      border-radius: var(--radius);
    }
  }

  .case-module {
    margin: 0;
  }

  /* модули не «на всю ширину» на Behance стоят с полями */
  .case-module:not(.is-full, .case-text) {
    width: calc(100% - 2 * clamp(16px, 6.5%, 90px));
    margin-inline: auto;
  }

  .case-module img,
  .case-loop {
    display: block;
    width: 100%;
    height: auto;
  }

  .case-embed {
    width: 100%;
    margin-inline: auto;
  }

  .case-module figcaption {
    padding: 8px 16px;
    font-size: 14px;
    font-style: italic;
    color: #a4a4a4;
  }

  .case-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 280px), 1fr));
  }

  .case-grid figcaption {
    grid-column: 1 / -1;
  }

  .case-video,
  .case-embed {
    position: relative;
    background: #000;
  }

  .case-video img,
  .case-video :global(iframe),
  .case-embed :global(iframe) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
  }

  /* прозрачный слой над видео; снизу открыта панель плеера */
  .case-video :global(.case-video-hit) {
    position: absolute;
    inset: 0 0 72px;
    z-index: 1;
    padding: 0;
    border: 0;
    background: transparent;
    cursor: pointer;
  }

  .case-video img {
    object-fit: cover;
    transition: opacity 0.4s;
  }

  .case-video:global(.is-ready) img {
    opacity: 0;
  }

  /* текст как на Behance: шрифт, цвет и размер из стилей проекта, инлайн-стили блока поверх */
  .case-text {
    padding: 0 clamp(16px, 6.5%, 90px);
    color: var(--canvas-text);
    font-family: helvetica, arial, sans-serif;
    font-size: 20px;
    line-height: 1.4;
    overflow-wrap: anywhere;
    padding-block: 40px;
  }

  .case-text :global(.bold) {
    font-weight: 700;
  }

  .case-text :global(a) {
    color: var(--canvas-link);
  }

  @media (max-width: 767px) {
    .case-text :global([style*='font-size']) {
      font-size: min(1em, 7vw) !important;
    }
  }


</style>
