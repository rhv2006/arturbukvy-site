---
// Страница 404. Цифры рисуются на холсте и «шумят» полосками, как сбойный кадр
// (эффект по мотивам FuzzyText из React Bits, переписан на чистый JS без React).
// При наведении шум сильнее, клик даёт вспышку, раз в пару секунд проскакивает глитч.
import '@fontsource-variable/unbounded';
import '@fontsource-variable/manrope';
import '../styles/global.css';

const title = 'Страница не найдена — артурбуквы';
---

<!doctype html>
<html lang="ru">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="dark" />
    <meta name="theme-color" content="#0b0b0d" />
    <title>{title}</title>
    <meta name="robots" content="noindex" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  </head>
  <body>
    <main class="nf">
      <a class="nf-home-link" href="/">← артурбуквы</a>
      <h1 class="nf-code">
        <canvas class="nf-fuzz" data-fuzz="404" role="img" aria-label="404"></canvas>
        <span class="nf-fallback">404</span>
      </h1>
      <p class="nf-label">Кадр потерялся при рендере</p>
      <p class="nf-text">Такой страницы нет. Возможно, ссылка устарела или в адресе опечатка.</p>
      <a class="btn btn-primary" href="/">На главную</a>
    </main>

    <script>
      const canvas = document.querySelector<HTMLCanvasElement>('[data-fuzz]')!;
      const fallback = document.querySelector<HTMLElement>('.nf-fallback')!;
      const ctx = canvas.getContext('2d');
      const text = canvas.dataset.fuzz || '404';
      const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;

      // настройки шума
      const BASE = 0.16; // в покое
      const HOVER = 0.5; // под курсором
      const RANGE = 34; // максимальный сдвиг полоски, px
      const SPLIT = 0.5; // расхождение каналов RGB, как хроматическая аберрация
      const GLITCH_EVERY = 2600, GLITCH_LEN = 180; // мс
      const INTRO = 1400; // проявление из сильного шума, мс
      const FPS = 60;

      if (ctx) {
        const src = document.createElement('canvas');
        const sctx = src.getContext('2d')!;
        // три копии цифр — по одной на канал R, G, B; складываются обратно в исходный цвет
        const chans = [0, 1, 2].map(() => document.createElement('canvas'));
        const padX = RANGE + 20 + Math.ceil(RANGE * 0.5) + 4;
        const inset = 5;
        let dpr = 1, fontPx = 16, ink = '#d4ff3a';
        let box = { left: 0, ascent: 0, w: 0, h: 0, cw: 0, ch: 0 };
        let rows = new Int32Array(1);
        let hovering = false, clicking = false, glitch = false;
        let introStart = 0, introDone = reduce;
        let raf = 0, last = 0, visible = true, built = false, drawn = -1;
        let intensity = reduce ? 0 : BASE, coarse = 1;

        const font = () => {
          const cs = getComputedStyle(canvas);
          return `${cs.fontWeight} ${fontPx}px ${cs.fontFamily}`;
        };

        const paint = (target: HTMLCanvasElement, color: string) => {
          target.width = src.width;
          target.height = src.height;
          const c = target.getContext('2d')!;
          c.setTransform(dpr, 0, 0, dpr, 0, 0);
          c.clearRect(0, 0, target.width, target.height);
          c.font = font();
          c.textBaseline = 'alphabetic';
          c.fillStyle = color;
          c.fillText(text, inset + box.left, box.ascent);
        };

        const build = () => {
          const cs = getComputedStyle(canvas);
          dpr = Math.min(devicePixelRatio || 1, 2);
          fontPx = parseFloat(cs.fontSize) || 160;
          ink = cs.color;
          sctx.setTransform(1, 0, 0, 1, 0, 0);
          sctx.font = font();
          const m = sctx.measureText(text);
          const left = m.actualBoundingBoxLeft ?? 0;
          const w = Math.ceil(left + (m.actualBoundingBoxRight ?? m.width));
          const ascent = m.actualBoundingBoxAscent ?? fontPx;
          const h = Math.ceil(ascent + (m.actualBoundingBoxDescent ?? fontPx * 0.2));
          box = { left, ascent, w, h, cw: w + inset * 2 + padX * 2, ch: h };
          src.width = Math.ceil((w + inset * 2) * dpr);
          src.height = Math.ceil(h * dpr);
          canvas.width = Math.ceil(box.cw * dpr);
          canvas.height = Math.ceil(box.ch * dpr);
          canvas.style.width = `${box.cw}px`;
          canvas.style.height = `${box.ch}px`;
          rows = new Int32Array(src.height + 1);
          paint(src, ink);
          // цвет цифр раскладываем на каналы: каждая копия несёт только свой
          const probe = document.createElement('canvas').getContext('2d', { willReadFrequently: true })!;
          probe.fillStyle = ink;
          probe.fillRect(0, 0, 1, 1);
          const rgb = Array.from(probe.getImageData(0, 0, 1, 1).data.slice(0, 3));
          chans.forEach((ch, i) => paint(ch, `rgb(${rgb.map((v, j) => (j === i ? v : 0)).join(',')})`));
          built = true;
          canvas.classList.add('is-ready');
          fallback.style.display = 'none';
          if (!introDone) canvas.style.opacity = '0';
          draw();
        };

        // рисует копию, сдвигая каждую горизонтальную полоску на свою случайную величину
        const fuzz = (img: HTMLCanvasElement, shift: number, jitter: number, step: number, amp: number) => {
          const ox = Math.round(padX * dpr);
          if (amp < 0.5) return ctx.drawImage(img, ox + shift, 0);
          for (let y = 0, i = 0; y < img.height; y += step, i++) {
            const h = Math.min(step, img.height - y);
            const wob = jitter ? Math.round((Math.random() - 0.5) * jitter) : 0;
            ctx.drawImage(img, 0, y, img.width, h, ox + rows[i] + wob + shift, y, img.width, h);
          }
        };

        const draw = () => {
          const step = Math.max(1, Math.round(coarse * dpr));
          const amp = intensity * RANGE * dpr;
          ctx.setTransform(1, 0, 0, 1, 0, 0);
          ctx.globalCompositeOperation = 'source-over';
          ctx.clearRect(0, 0, canvas.width, canvas.height);
          drawn = intensity;
          if (amp >= 0.5) for (let i = 0; i * step < src.height; i++) rows[i] = Math.round((Math.random() - 0.5) * amp);
          const split = Math.round(SPLIT * (2 + intensity * RANGE * 0.18) * dpr);
          if (reduce || split < 1) return fuzz(src, 0, 0, step, amp);
          ctx.globalCompositeOperation = 'lighter';
          fuzz(chans[0], -split, SPLIT * amp * 0.2, step, amp);
          fuzz(chans[1], 0, 0, step, amp);
          fuzz(chans[2], split, SPLIT * amp * 0.2, step, amp);
          ctx.globalCompositeOperation = 'source-over';
        };

        const tick = (now: number) => {
          raf = 0;
          if (!visible) return;
          raf = requestAnimationFrame(tick);
          const interval = 1000 / FPS;
          if (now - last < interval - 1) return;
          last = Math.max(last + interval, now - interval);
          let level = reduce ? 0 : clicking || glitch ? 1 : hovering ? HOVER : BASE;
          let energy = 0;
          if (!introDone) {
            if (!introStart) introStart = now;
            const p = Math.min(1, (now - introStart) / INTRO);
            const env = Math.pow(1 - p, 2.5);
            level += (2 - level) * env;
            energy = env;
            canvas.style.opacity = p < 0.3 ? (1 - Math.pow(1 - p / 0.3, 2)).toFixed(3) : '';
            if (p >= 1) introDone = true;
          }
          intensity = level;
          coarse = 1 + 3 * energy * energy; // в начале полоски толще — как рваный сигнал
          if (intensity === 0 && drawn === 0) return;
          draw();
        };

        const overText = (e: PointerEvent) => {
          const r = canvas.getBoundingClientRect();
          if (!built || !r.width) return false;
          const x = ((e.clientX - r.left) * box.cw) / r.width;
          const y = ((e.clientY - r.top) * box.ch) / r.height;
          return x >= padX + inset && x <= padX + inset + box.w && y >= 0 && y <= box.h;
        };
        canvas.addEventListener('pointermove', (e) => (hovering = overText(e)));
        canvas.addEventListener('pointerdown', (e) => (hovering = overText(e)));
        canvas.addEventListener('pointerup', (e) => e.pointerType !== 'mouse' && (hovering = false));
        canvas.addEventListener('pointerleave', () => (hovering = false));
        let clickTimer = 0;
        canvas.addEventListener('click', () => {
          clicking = true;
          clearTimeout(clickTimer);
          clickTimer = window.setTimeout(() => (clicking = false), 150);
        });

        if (!reduce) {
          const schedule = () =>
            setTimeout(() => {
              glitch = true;
              setTimeout(() => ((glitch = false), schedule()), GLITCH_LEN);
            }, GLITCH_EVERY);
          schedule();
        }

        new IntersectionObserver(([en]) => {
          visible = en.isIntersecting;
          if (visible && built && !raf) raf = requestAnimationFrame(tick);
        }).observe(canvas);

        let resizeRaf = 0;
        addEventListener('resize', () => {
          cancelAnimationFrame(resizeRaf);
          resizeRaf = requestAnimationFrame(() => {
            const size = parseFloat(getComputedStyle(canvas).fontSize);
            if (built && (size !== fontPx || Math.min(devicePixelRatio || 1, 2) !== dpr)) build();
          });
        });

        (async () => {
          try {
            await document.fonts.load(`600 100px 'Unbounded Variable'`);
          } catch {
            await document.fonts.ready;
          }
          build();
          if (visible && !raf) raf = requestAnimationFrame(tick);
        })();
      }
    </script>
  </body>
</html>

<style>
  body {
    /* фон в точку, как на главной (здесь неподвижный) */
    background:
      radial-gradient(circle, rgb(52 78 18 / 0.75) 1.6px, transparent 2px) 0 0 / 26px 26px,
      var(--bg);
  }

  .nf {
    min-height: 100vh;
    min-height: 100svh;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0;
    padding: 96px var(--gutter) 64px;
    text-align: center;
  }

  .nf-home-link {
    position: absolute;
    top: 28px;
    left: var(--gutter);
    font: 600 15px/1 var(--body);
    color: var(--muted);
    transition: color 0.2s;
  }

  .nf-home-link:hover {
    color: var(--accent);
  }

  .nf-code {
    margin: 0 0 28px;
    line-height: 1;
    /* размер и шрифт холст берёт отсюда */
    font: 600 clamp(120px, 26vw, 400px) / 1 var(--display);
    color: var(--accent);
    letter-spacing: 0;
  }

  .nf-fuzz {
    display: block;
    max-width: none;
    margin-inline: auto;
    font: inherit;
    color: inherit;
  }

  .nf-fuzz:not(.is-ready) {
    position: absolute;
    visibility: hidden;
  }

  /* до загрузки шрифта (и без JS) — обычные цифры */
  .nf-fallback {
    display: block;
  }

  .nf-label {
    display: flex;
    align-items: center;
    gap: 12px;
    margin: 0 0 14px;
    font: 500 12px/1 var(--body);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--accent);
  }

  .nf-label::before {
    content: '';
    width: 8px;
    height: 8px;
    background: var(--accent);
    rotate: 45deg;
  }

  .nf-text {
    max-width: 460px;
    margin: 0 0 32px;
    font-size: clamp(17px, 1.15vw, 21px);
    line-height: 1.55;
    color: var(--muted);
  }

  @media (max-width: 599px) {
    .nf-fuzz {
      max-width: 100%;
      height: auto !important;
    }
  }
</style>
