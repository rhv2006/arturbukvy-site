          <div class="xp-stage">
            <div class="wrap xp-bar" aria-hidden="true">
              <span class="xp-comp">COMP · experience_{TL_FROM}–{TL_TO - 1}</span>
              <span class="xp-tc" data-xp-tc>{TL_FROM}.01</span>
              <span class="xp-pct"><span data-xp-pct>0%</span> · <span data-xp-hint>листайте ↓ или жмите пробел</span></span>
            </div>
            <div class="wrap xp-cards">
              <ol class="xp-list">
                {
                  timeline.map((job) => (
                    <li class="xp-job" data-start={job.start} data-end={job.end}>
                      <p class="xp-period">{job.period}</p>
                      <h3>{job.company}</h3>
                      <p class="xp-role">{job.role}</p>
                      <ul class="xp-points">
                        {job.points.map((p) => (
                          <li>{p}</li>
                        ))}
                      </ul>
                      {framesOf(job.layer).length > 0 && (
                        <div class="xp-shots">
                          {framesOf(job.layer).map((f) => (
                            <img src={f.src} alt={f.alt} width="1600" height="1200" loading="lazy" decoding="async" />
                          ))}
                        </div>
                      )}
                    </li>
                  ))
                }
              </ol>
              <div class="xp-render" data-xp-render>
                <div class="xp-rv-head">
                  <span class="xp-rv-title"><i class="xp-rv-dot" />Render View<span data-rv-file /></span>
                  <span data-rv-meta />
                </div>
                <div class="xp-rv-view">
                  {
                    frames.map((f) => (
                      <img
                        class="xp-rv-img"
                        data-src={f.src}
                        data-y={f.year}
                        data-file={f.file}
                        data-meta={`${f.job} · ${Math.floor(f.year)} · кадр ${f.n} / ${f.total}`}
                        alt={f.alt}
                        width="1600"
                        height="1200"
                        decoding="async"
                      />
                    ))
                  }
                  <canvas class="xp-rv-canvas" aria-hidden="true" />
                  <span class="xp-rv-badge">рендер <span data-rv-pct>0</span>%</span>
                  <div class="xp-rv-progress"><i class="xp-rv-fill" /></div>
                </div>
              </div>
            </div>
            <div class="wrap xp-panel-wrap" aria-hidden="true">
              <div class="xp-panel">
                <div class="xp-layers">
                  <div class="xp-layers-head">Слои</div>
                  <div class="xp-layer xp-layer-cases" style="--c:var(--accent)">
                    <span class="xp-dot" />
                    Кейсы
                  </div>
                  {
                    timeline.map((job) => (
                      <div class="xp-layer" style={`--c:${job.color}`}>
                        <span class="xp-dot" />
                        {job.layer}
                      </div>
                    ))
                  }
                </div>
                <div class="xp-area">
                  <div class="xp-tracks">
                    <div class="xp-ruler">
                      {tlYears.map((y) => (
                        <span class="xp-tick" style={`--x:${y - TL_FROM}`}>{y}</span>
                      ))}
                    </div>
                    <div class="xp-lane xp-lane-cases">
                      {frames.map((f) => (
                        <i class="xp-case" data-y={f.year} style={`--x:${f.year - TL_FROM}`} />
                      ))}
                    </div>
                    {
                      timeline.map((job) => (
                        <div class="xp-lane">
                          <div class="xp-clip" style={`--x:${job.start - TL_FROM};--w:${job.end - job.start};--c:${job.color}`}>
                            <span>{job.company}</span>
                          </div>
                          {job.keys.map((k) => (
                            <i class="xp-key" data-y={k} style={`--x:${k - TL_FROM}`} />
                          ))}
                        </div>
                      ))
                    }
                  </div>
                  <div class="xp-head" />
                </div>
              </div>
            </div>
          </div>
        </div>
        <div class="wrap">
          <p class="edu">Образование: МГГУ им. Шолохова, графический дизайн, 2013</p>
        </div>
      </section>

      <section class="wrap xp-cta">
        <div>
          <h3>Всё то же самое — одним файлом</h3>
          <p>Резюме в PDF для тех, кому некогда листать.</p>
        </div>
        <div class="xp-cta-btns">
          <a class="btn btn-primary" href={site.resumePdf} target="_blank" rel="noopener">Скачать резюме PDF</a>
          <a class="btn btn-ghost" href={site.resumePdfEn} target="_blank" rel="noopener" hreflang="en" lang="en">CV in English</a>
        </div>
      </section>

      {
        articles.length > 0 && (
          <section id="articles" class="section wrap">
            <div class="section-head">
              <div>
                <h2>Статьи об автоматизации</h2>
                <p class="section-lead">
                  Как я убираю рутину из продакшена: скрипты для Illustrator, пакетный рендер в Cinema 4D, Python-боты.
                </p>
              </div>
              <a class="link link-accent" href={site.automation} target="_blank" rel="noopener">Все статьи на Teletype ↗</a>
            </div>
            <ul class="articles">
              {articles.map((a) => (
                <li class="card article">
                  <a href={a.url} target="_blank" rel="noopener" data-cursor="Читать">
                    <div class:list={['card-media', !a.cover && 'no-cover']} data-tilt>
                      {a.cover ? (
                        <img src={a.cover} alt="" loading="lazy" decoding="async" />
                      ) : (
                        <span class="no-cover-mark" aria-hidden="true">{'</>'}</span>
                      )}
                    </div>
                    <p class="article-date">{dateRu(a.date)}</p>
                    <h3>
                      <span class="title-line">{a.title}</span>
                      <span class="arrow" aria-hidden="true">↗</span>
                    </h3>
                    {a.excerpt && <p class="article-excerpt">{a.excerpt}</p>}
                  </a>
                </li>
              ))}
            </ul>
          </section>
        )
      }

      <Contact behance={site.behance} />
    </main>

    <footer class="wrap footer">
      <span>© {new Date().getFullYear()} {site.name}</span>
      <span>артурбуквы.рф</span>
    </footer>

    <Cursor />
    <SmoothScroll />

    <dialog class="reel" aria-label="Шоурил">
      <button class="reel-close" type="button" data-close-reel aria-label="Закрыть">×</button>
      <div class="reel-frame">
        <video data-src="/video/reel.mp4" poster="/video/reel-poster.jpg" controls playsinline preload="none"></video>
      </div>
      <p class="reel-fallback">
        Шоурил также на <a class="link" href={site.reelVimeo} target="_blank" rel="noopener">Vimeo ↗</a>
      </p>
    </dialog>

    <script>
      // Фоновые видео: файл грузим, только когда ролик рядом с экраном, и ставим на паузу вне экрана.
      // Тем, кто просил меньше анимации, видео не включаем: остаются постер и обложки.
      const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
      if (!reduce) {
        const io = new IntersectionObserver(
          (entries) =>
            entries.forEach(({ target, isIntersecting }) => {
              const v = target as HTMLVideoElement;
              if (!isIntersecting) return v.pause();
              if (!v.src && v.dataset.src) {
                v.src = v.dataset.src;
                v.addEventListener('playing', () => v.classList.add('is-ready'), { once: true });
              }
              v.play().catch(() => {});
            }),
          { rootMargin: '200px' },
        );
        document.querySelectorAll<HTMLVideoElement>('video.bg-video').forEach((v) => io.observe(v));
      }

      // Эффекты при наведении — только для мыши (на тач-экранах наведения нет).
      const finePointer = matchMedia('(hover: hover) and (pointer: fine)').matches;
      if (finePointer && !reduce) {
        // Лёгкий 3D-наклон обложки за курсором.
        document.querySelectorAll<HTMLElement>('[data-tilt]').forEach((el) => {
          el.addEventListener('pointermove', (e) => {
            const r = el.getBoundingClientRect();
            const px = (e.clientX - r.left) / r.width - 0.5;
            const py = (e.clientY - r.top) / r.height - 0.5;
            el.style.setProperty('--rx', `${(-py * 6).toFixed(2)}deg`);
            el.style.setProperty('--ry', `${(px * 6).toFixed(2)}deg`);
            el.style.setProperty('--gx', `${((px + 0.5) * 100).toFixed(1)}%`);
            el.style.setProperty('--gy', `${((py + 0.5) * 100).toFixed(1)}%`);
          });
          el.addEventListener('pointerleave', () => {
            el.style.removeProperty('--rx');
            el.style.removeProperty('--ry');
          });
        });
      }

      // Мобильное меню: кнопка-бургер, закрытие по ссылке, Esc и клику мимо.
      const topbar = document.querySelector<HTMLElement>('.topbar')!;

      // Зелёное свечение в шапке едет за курсором.
      const pill = topbar.querySelector<HTMLElement>('.topbar-pill')!;
      const glow = pill.querySelector<HTMLElement>('.pill-glow')!;
      pill.addEventListener('pointermove', (e) => {
        const r = pill.getBoundingClientRect();
        glow.style.setProperty('--gx', `${e.clientX - r.left}px`);
        glow.style.setProperty('--gy', `${e.clientY - r.top}px`);
      });
      const menuBtn = topbar.querySelector<HTMLButtonElement>('.menu-btn')!;
      const setMenu = (open: boolean) => {
        topbar.classList.toggle('is-menu', open);
        menuBtn.setAttribute('aria-expanded', String(open));
        menuBtn.setAttribute('aria-label', open ? 'Закрыть меню' : 'Открыть меню');
      };
      menuBtn.addEventListener('click', () => setMenu(!topbar.classList.contains('is-menu')));
      topbar.querySelectorAll('.mobile-menu a').forEach((a) => a.addEventListener('click', () => setMenu(false)));
      addEventListener('keydown', (e) => e.key === 'Escape' && setMenu(false));
      document.addEventListener('click', (e) => {
        if (!topbar.contains(e.target as Node)) setMenu(false);
      });

      // Фон из тёмно-зелёных точек на весь сайт. Точки медленно дрейфуют, расступаются кругом
      // вокруг курсора и пружиной возвращаются; клик пускает волну. При reduced motion — неподвижная сетка.
      {
        const canvas = document.createElement('canvas');
        canvas.className = 'dots';
        canvas.setAttribute('aria-hidden', 'true');
        document.body.prepend(canvas);
        const ctx = canvas.getContext('2d')!;
        const interactive = finePointer && !reduce;
        const COLORS = ['rgb(52 78 18 / 0.75)', 'rgb(110 160 30 / 0.85)', 'rgb(212 255 58 / 0.95)'];
        const GAP = 26;
        const DOT = 1.6;
        const RADIUS = 110; // радиус «пустого» круга вокруг курсора
        const DRIFT = 7; // насколько далеко точка уплывает от своего места, px

        let w = 0, h = 0, dpr = 1, raf = 0;
        let hx = new Float32Array(0), hy = hx, px = hx, py = hx, vx = hx, vy = hx;
        let ph1 = hx, ph2 = hx, sp1 = hx, sp2 = hx;
        let mx = -9999, my = -9999;
        const waves: { x: number; y: number; r: number; life: number }[] = [];

        const build = () => {
          dpr = Math.min(devicePixelRatio || 1, 2);
          w = innerWidth;
          h = innerHeight;
          canvas.width = w * dpr;
          canvas.height = h * dpr;
          const cols = Math.ceil(w / GAP) + 1;
          const rows = Math.ceil(h / GAP) + 1;
          const n = cols * rows;
          hx = new Float32Array(n); hy = new Float32Array(n);
          px = new Float32Array(n); py = new Float32Array(n);
          vx = new Float32Array(n); vy = new Float32Array(n);
          ph1 = new Float32Array(n); ph2 = new Float32Array(n);
          sp1 = new Float32Array(n); sp2 = new Float32Array(n);
          const ox = (w - (cols - 1) * GAP) / 2;
          const oy = (h - (rows - 1) * GAP) / 2;
          for (let r = 0, i = 0; r < rows; r++)
            for (let c = 0; c < cols; c++, i++) {
              hx[i] = px[i] = ox + c * GAP;
              hy[i] = py[i] = oy + r * GAP;
              // у каждой точки свой медленный ритм: период примерно 9–20 секунд
              ph1[i] = Math.random() * Math.PI * 2;
              ph2[i] = Math.random() * Math.PI * 2;
              sp1[i] = (0.3 + Math.random() * 0.4) / 1000;
              sp2[i] = (0.3 + Math.random() * 0.4) / 1000;
            }
          draw();
        };

        const draw = () => {
          ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
          ctx.clearRect(0, 0, w, h);
          // три яркости: спокойные — тёмно-зелёные, сдвинутые курсором или волной — светлее
          const paths = [new Path2D(), new Path2D(), new Path2D()];
          for (let i = 0; i < hx.length; i++) {
            const sp = Math.abs(vx[i]) + Math.abs(vy[i]);
            const off = Math.abs(px[i] - hx[i]) + Math.abs(py[i] - hy[i]) - DRIFT * 2; // сдвиг сверх дрейфа
            const b = sp > 2.5 || off > 18 ? 2 : sp > 0.6 || off > 4 ? 1 : 0;
            paths[b].moveTo(px[i] + DOT, py[i]);
            paths[b].arc(px[i], py[i], DOT, 0, Math.PI * 2);
          }
          paths.forEach((p, b) => {
            ctx.fillStyle = COLORS[b];
            ctx.fill(p);
          });
        };

        const step = (t: number) => {
          for (const wv of waves) {
            wv.r += 16;
            wv.life--;
          }
          for (let i = waves.length - 1; i >= 0; i--) if (waves[i].life <= 0) waves.splice(i, 1);

          for (let i = 0; i < hx.length; i++) {
            // место, к которому точка тянется, само медленно плавает
            const tx = hx[i] + Math.sin(t * sp1[i] + ph1[i]) * DRIFT;
            const ty = hy[i] + Math.cos(t * sp2[i] + ph2[i]) * DRIFT;
            let fx = (tx - px[i]) * 0.07;
            let fy = (ty - py[i]) * 0.07;
            const dx = px[i] - mx, dy = py[i] - my;
            const d2 = dx * dx + dy * dy;
            if (d2 < RADIUS * RADIUS) {
              const d = Math.sqrt(d2) || 1;
              const push = (RADIUS - d) * 0.18;
              fx += (dx / d) * push;
              fy += (dy / d) * push;
            }
            for (const wv of waves) {
              const ex = px[i] - wv.x, ey = py[i] - wv.y;
              const d = Math.sqrt(ex * ex + ey * ey) || 1;
              const band = Math.abs(d - wv.r);
              if (band < 40) {
                const k = (1 - band / 40) * (wv.life / 40) * 10;
                fx += (ex / d) * k;
                fy += (ey / d) * k;
              }
            }
            vx[i] = (vx[i] + fx) * 0.72;
            vy[i] = (vy[i] + fy) * 0.72;
            px[i] += vx[i];
            py[i] += vy[i];
          }
          draw();
          raf = requestAnimationFrame(step);
        };

        build();
        let rt = 0;
        addEventListener('resize', () => {
          clearTimeout(rt);
          rt = window.setTimeout(build, 120);
        });

        if (!reduce) {
          raf = requestAnimationFrame(step);
          // в фоновой вкладке не считаем
          document.addEventListener('visibilitychange', () => {
            cancelAnimationFrame(raf);
            if (!document.hidden) raf = requestAnimationFrame(step);
          });
        }

        if (interactive) {
          addEventListener('pointermove', (e) => {
            if (e.pointerType !== 'mouse') return;
            mx = e.clientX;
            my = e.clientY;
          });
          document.addEventListener('pointerleave', () => {
            mx = my = -9999;
          });
          addEventListener('pointerdown', (e) => {
            if (e.pointerType !== 'mouse' || e.button !== 0) return;
            waves.push({ x: e.clientX, y: e.clientY, r: 0, life: 40 });
          });
        }
      }

      // Искры разлетаются от курсора при клике на кейс, статью или кнопку.
      if (finePointer && !reduce) {
        const canvas = document.createElement('canvas');
        canvas.className = 'sparks';
        canvas.setAttribute('aria-hidden', 'true');
        document.body.append(canvas);
        const ctx = canvas.getContext('2d')!;
        const accent = getComputedStyle(document.documentElement).getPropertyValue('--accent').trim() || '#d4ff3a';
        type S = { x: number; y: number; vx: number; vy: number; life: number; max: number; r: number };
        const ss: S[] = [];
        let dpr = 1, raf = 0;
        const resize = () => {
          dpr = Math.min(devicePixelRatio || 1, 2);
          canvas.width = innerWidth * dpr;
          canvas.height = innerHeight * dpr;
        };
        resize();
        addEventListener('resize', resize);

        const tick = () => {
          ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
          ctx.clearRect(0, 0, innerWidth, innerHeight);
          ctx.globalCompositeOperation = 'lighter';
          ctx.fillStyle = accent;
          for (let i = ss.length - 1; i >= 0; i--) {
            const s = ss[i];
            if (++s.life >= s.max) {
              ss.splice(i, 1);
              continue;
            }
            const t = 1 - s.life / s.max;
            s.vx *= 0.93;
            s.vy = s.vy * 0.93 + 0.08;
            s.x += s.vx;
            s.y += s.vy;
            const r = s.r * (0.3 + 0.7 * t);
            ctx.globalAlpha = t * 0.3;
            ctx.beginPath();
            ctx.arc(s.x, s.y, r * 3, 0, Math.PI * 2);
            ctx.fill();
            ctx.globalAlpha = t;
            ctx.beginPath();
            ctx.arc(s.x, s.y, r, 0, Math.PI * 2);
            ctx.fill();
          }
          ctx.globalAlpha = 1;
          raf = ss.length ? requestAnimationFrame(tick) : 0;
        };

        addEventListener('pointerdown', (e) => {
          if (e.pointerType !== 'mouse' || e.button !== 0) return;
          if (!(e.target instanceof Element) || !e.target.closest('a, button, [data-cursor]')) return;
          const { clientX: x, clientY: y } = e;
          const count = 40;
          for (let i = 0; i < count; i++) {
            const a = Math.random() * Math.PI * 2;
            const s = 2 + Math.random() * 8;
            ss.push({ x, y, vx: Math.cos(a) * s, vy: Math.sin(a) * s - 1.5, life: 0, max: 35 + Math.random() * 35, r: 1.5 + Math.random() * 2.5 });
          }
          raf ||= requestAnimationFrame(tick);
        });
      }

      // «Опыт»: таймлайн в духе After Effects. Секция закреплена (sticky), колесо не перехватывается:
      // прогресс прокрутки обёртки 0–1 → «текущий год» 2011–2026, дорожки едут под неподвижным плейхедом.
      // Только на экранах от 760px и без reduced motion; иначе остаётся обычный вертикальный список.
      {
        const sec = document.querySelector<HTMLElement>('[data-xp]');
        if (sec) {
          const mq = matchMedia('(min-width: 760px) and (prefers-reduced-motion: no-preference)');
          const scroller = sec.querySelector<HTMLElement>('.xp-scroll')!;
          const panel = sec.querySelector<HTMLElement>('.xp-panel')!;
          const area = sec.querySelector<HTMLElement>('.xp-area')!;
          const tracks = sec.querySelector<HTMLElement>('.xp-tracks')!;
          const head = sec.querySelector<HTMLElement>('.xp-head')!;
          const list = sec.querySelector<HTMLElement>('.xp-list')!;
          const tcEl = sec.querySelector<HTMLElement>('[data-xp-tc]')!;
          const pctEl = sec.querySelector<HTMLElement>('[data-xp-pct]')!;
          const hintEl = sec.querySelector<HTMLElement>('[data-xp-hint]')!;
          const HINT = hintEl.textContent;
          const jobs = [...sec.querySelectorAll<HTMLElement>('.xp-job')];
          const clips = [...sec.querySelectorAll<HTMLElement>('.xp-clip')];
          const layers = [...sec.querySelectorAll<HTMLElement>('.xp-layer:not(.xp-layer-cases)')];
          // от 1100px рядом с карточкой — окно Render View
          const wideMq = matchMedia('(min-width: 1100px)');
          const spans = jobs.map((j) => [Number(j.dataset.start), Number(j.dataset.end)]);
          const keys = [...sec.querySelectorAll<HTMLElement>('.xp-key')]
            .map((el) => ({ el, y: Number(el.dataset.y) }))
            .sort((a, b) => a.y - b.y);

          const Y0 = 2011;
          const YEND = 2027 - 1e-4; // к концу секции таймкод показывает 2026.12
          // Время идёт равномерно по кадрам, а не по годам: от кадра до кадра Render View
          // (и от последнего кадра до конца) — одинаковый отрезок прокрутки и автоплея.
          // Между двумя кадрами годы идут линейно, поэтому в «пустые» годы плейхед едет быстрее.
          const SHOT_VH = 33; // прокрутка на один кадр
          const SHOT_MS = 1130; // время на кадр в автоплее: ~0,55 с рендер + ~0,55 с готовая картинка
          const knots = [
            ...new Set([
              Y0,
              ...[...sec.querySelectorAll<HTMLElement>('.xp-rv-img')]
                .map((im) => Number(im.dataset.y))
                .filter((y) => y > Y0 && y < YEND),
              YEND,
            ]),
          ].sort((a, b) => a - b);
          const SHOTS = knots.length - 1;
          // прогресс 0–1 → год таймлайна
          const toYear = (p: number) => {
            const u = p * SHOTS;
            const i = Math.min(SHOTS - 1, Math.floor(u));
            return knots[i] + (u - i) * (knots[i + 1] - knots[i]);
          };
          const cardsEl = sec.querySelector<HTMLElement>('.xp-cards')!;
          let ppy = 200, playX = 0, total = 1, raf = 0, on = false;
          let lastTc = '', lastPct = -1, doneCount = 0, activeKey = '';

          const measure = () => {
            const w = area.clientWidth;
            ppy = Math.max(140, Math.round(w / 4.5)); // в окне видно ~4,5 года
            panel.style.setProperty('--ppy', `${ppy}px`);
            playX = Math.round(w * 0.3);
            head.style.transform = `translateX(${playX}px)`;
            scroller.style.height = `calc(100vh + ${SHOTS * SHOT_VH}vh)`;
            total = Math.max(1, scroller.offsetHeight - innerHeight);
            // окно Render View — 4:3 по всей доступной высоте (40px — шапка окна, 2px — рамка),
            // но не шире половины ряда, чтобы главной оставалась карточка
            const rvH = cardsEl.clientHeight - 42;
            const rvW = Math.min(Math.round((rvH * 4) / 3) + 2, Math.round((cardsEl.clientWidth - 32) / 2));
            cardsEl.style.setProperty('--rv-w', `${Math.max(240, rvW)}px`);
          };

          const setActive = (year: number) => {
            let idx = spans.flatMap(([a, b], i) => (year >= a && year < b ? [i] : []));
            // после конца последнего места (pronew до 08.2026) держим самое свежее
            if (!idx.length) {
              let best = 0;
              spans.forEach(([, b], i) => b <= year && b > spans[best][1] && (best = i));
              idx = [best];
            }
            const k = idx.join();
            if (k === activeKey) return;
            activeKey = k;
            // самая свежая из идущих работ (позже всех началась; при равенстве — та, что выше в списке)
            const lead = idx.reduce((a, b) => (spans[b][0] > spans[a][0] ? b : a));
            jobs.forEach((el, i) => {
              el.classList.toggle('is-active', idx.includes(i));
              el.classList.toggle('is-lead', i === lead);
            });
            clips.forEach((el, i) => el.classList.toggle('is-on', idx.includes(i)));
            layers.forEach((el, i) => el.classList.toggle('is-on', idx.includes(i)));
            list.dataset.n = String(wideMq.matches ? 1 : idx.length);
          };

          // Окно Render View: активный кадр — последний, чей год <= текущего года таймлайна.
          // Смена кадра — как прогрессивный 3D-рендер: кадр проступает из цветного шума,
          // крупные пиксели дробятся до полного разрешения, шум «досэмплируется» и уходит.
          // Полоса и плашка «рендер NN%» идут синхронно. Рисуется на canvas поверх картинок;
          // вызывается из frame(), своего scroll-слушателя нет.
          const rv = sec.querySelector<HTMLElement>('[data-xp-render]')!;
          const rvView = rv.querySelector<HTMLElement>('.xp-rv-view')!;
          const rvImgs = [...rv.querySelectorAll<HTMLImageElement>('.xp-rv-img')]; // уже по возрастанию года
          const rvYears = rvImgs.map((im) => Number(im.dataset.y));
          const rvFile = rv.querySelector<HTMLElement>('[data-rv-file]')!;
          const rvMeta = rv.querySelector<HTMLElement>('[data-rv-meta]')!;
          const rvPct = rv.querySelector<HTMLElement>('[data-rv-pct]')!;
          const rvFill = rv.querySelector<HTMLElement>('.xp-rv-fill')!;
          const rvCanvas = rv.querySelector<HTMLCanvasElement>('.xp-rv-canvas')!;
          const rvCtx = rvCanvas.getContext('2d')!;
          const rvSmall = document.createElement('canvas'); // кадр в низком разрешении
          const rvSmallCtx = rvSmall.getContext('2d')!;
          const cases = [...sec.querySelectorAll<HTMLElement>('.xp-case')]; // в том же порядке, что кадры
          const REVEAL_MS = 550;
          const BLOCK = 40; // размер «пикселя» в начале рендера, px
          let rvCur = -2, rvAnim = 0;
          let rvTop: HTMLImageElement | null = null;
          let rvNoise: CanvasPattern | null = null;

          // тайл шума недосэмплированного рендера: тёмное цветное зерно и редкие яркие «светлячки»
          const makeNoise = () => {
            const c = document.createElement('canvas');
            c.width = c.height = 256;
            const x = c.getContext('2d')!;
            const d = x.createImageData(256, 256);
            for (let i = 0; i < d.data.length; i += 4) {
              const v = Math.random() < 0.06 ? 170 + Math.random() * 85 : Math.random() * 70;
              d.data[i] = v * (0.6 + Math.random() * 0.8);
              d.data[i + 1] = v * (0.6 + Math.random() * 0.8);
              d.data[i + 2] = v * (0.6 + Math.random() * 0.8);
              d.data[i + 3] = 255;
            }
            x.putImageData(d, 0, 0);
            return rvCtx.createPattern(c, 'repeat');
          };

          // картинки окна грузятся по требованию: текущая и соседние
          const rvLoad = (i: number) => {
            const im = rvImgs[i];
            if (im && !im.getAttribute('src')) im.src = im.dataset.src!;
          };
          const ready = (im: HTMLImageElement) => im.complete && im.naturalWidth > 0;
          const rvSet = (k: number) => {
            rvFill.style.transform = `scaleX(${k})`;
            rvPct.textContent = String(Math.round(k * 100));
          };
          // видна только верхняя картинка, холст выключен
          const rvSettle = () => {
            rvImgs.forEach((im) => im.classList.toggle('is-shown', im === rvTop));
            rvCanvas.classList.remove('is-on');
          };
          // один кадр рендера: k = 0 — чистый шум, k = 1 — готовая картинка
          const rvDraw = (im: HTMLImageElement, k: number) => {
            const W = rvCanvas.width, H = rvCanvas.height;
            if (ready(im)) {
              const s = Math.max(1, Math.round(BLOCK * (1 - k) ** 2));
              const w = Math.ceil(W / s), h = Math.ceil(H / s);
              rvSmall.width = w;
              rvSmall.height = h;
              // как object-fit: cover
              const iw = im.naturalWidth, ih = im.naturalHeight;
              const sc = Math.max(W / iw, H / ih);
              const sw = W / sc, sh = H / sc;
              rvSmallCtx.drawImage(im, (iw - sw) / 2, (ih - sh) / 2, sw, sh, 0, 0, w, h);
              rvCtx.imageSmoothingEnabled = false;
              rvCtx.globalAlpha = 1;
              rvCtx.drawImage(rvSmall, 0, 0, w, h, 0, 0, w * s, h * s);
            }
            const na = ready(im) ? 0.92 * (1 - k) ** 1.4 : 1;
            if (na > 0.01 && rvNoise) {
              const ox = (Math.random() * 256) | 0, oy = (Math.random() * 256) | 0;
              rvCtx.globalAlpha = na;
              rvCtx.fillStyle = rvNoise;
              rvCtx.translate(-ox, -oy);
              rvCtx.fillRect(ox, oy, W, H);
              rvCtx.setTransform(1, 0, 0, 1, 0, 0);
              rvCtx.globalAlpha = 1;
            }
          };
          const rvShow = (i: number, animate: boolean) => {
            cancelAnimationFrame(rvAnim);
            rvAnim = 0;
            rv.classList.toggle('has-frame', i >= 0);
            if (i < 0) {
              // до первого кадра — пустое окно: «Render View» и тёмный фон
              rvTop = null;
              rvFile.textContent = rvMeta.textContent = '';
              rvSet(0);
              rvSettle();
              return;
            }
            const im = rvImgs[i];
            rvLoad(i);
            rvLoad(i + 1);
            rvLoad(i - 1);
            rvFile.textContent = im.dataset.file!;
            rvMeta.textContent = im.dataset.meta!;
            rvTop = im;
            if (!animate) {
              rvSet(1);
              rvSettle();
              return;
            }
            // новый рендер начинается с шума поверх того, что было видно, — в том числе с недорендеренного кадра
            rvCanvas.width = Math.max(1, rvView.clientWidth);
            rvCanvas.height = Math.max(1, rvView.clientHeight);
            rvNoise ||= makeNoise();
            rvDraw(im, 0);
            rvCanvas.classList.add('is-on');
            rvSet(0);
            let t0 = 0;
            const step = (now: number) => {
              // пока картинка грузится, «рендер» шумит на 0%
              if (!ready(im)) {
                rvDraw(im, 0);
                rvAnim = requestAnimationFrame(step);
                return;
              }
              t0 ||= now;
              const t = Math.min(1, (now - t0) / REVEAL_MS);
              const k = 1 - (1 - t) ** 2; // ease-out
              rvDraw(im, k);
              rvSet(k);
              if (t < 1) rvAnim = requestAnimationFrame(step);
              else {
                rvAnim = 0;
                rvSettle();
              }
            };
            rvAnim = requestAnimationFrame(step);
          };
          const renderAt = (year: number) => {
            let i = -1;
            while (i + 1 < rvYears.length && rvYears[i + 1] <= year) i++;
            if (i === rvCur) return;
            const first = rvCur === -2;
            rvCur = i;
            cases.forEach((c, j) => c.classList.toggle('is-done', j <= i));
            // окно видно только от 1100px; уже — только маркеры на дорожке
            if (wideMq.matches) rvShow(i, !first);
          };
          const rvReset = () => {
            cancelAnimationFrame(rvAnim);
            rvAnim = 0;
            rvCur = -2;
            rvTop = null;
            rvSettle();
            rv.classList.remove('has-frame');
            cases.forEach((c) => c.classList.remove('is-done'));
          };

          const frame = () => {
            raf = 0;
            const r = scroller.getBoundingClientRect();
            const p = Math.min(1, Math.max(0, -r.top / total));
            const year = toYear(p);
            tracks.style.transform = `translate3d(${(playX - (year - Y0) * ppy).toFixed(1)}px,0,0)`;

            const y = Math.floor(year);
            const m = Math.min(12, Math.floor((year - y) * 12) + 1);
            const tc = `${y}.${String(m).padStart(2, '0')}`;
            if (tc !== lastTc) tcEl.textContent = lastTc = tc;
            const pct = Math.round(p * 100);
            if (pct !== lastPct) pctEl.textContent = `${(lastPct = pct)}%`;

            // ромбики по порядку: закрашиваем пройденные, сбрасываем при прокрутке назад
            let n = 0;
            while (n < keys.length && keys[n].y <= year) n++;
            if (n !== doneCount) {
              keys.forEach((k, i) => (i < Math.max(n, doneCount)) && k.el.classList.toggle('is-done', i < n));
              doneCount = n;
            }
            setActive(year);
            renderAt(year);
            autoCheck(r, p);
          };

          const request = () => (raf ||= requestAnimationFrame(frame));

          // Автопроигрывание, как в After Effects: когда сцена закрепляется при прокрутке вниз,
          // страница сама докручивает таймлайн до конца (SHOT_MS на каждый кадр Render View).
          // Пробел — пауза/дальше; колесо, клавиши, тач или клик — стоп, дальше листаете сами.
          // Подсказка — на курсоре (над сценой) и в строке сверху. Снова само запустится,
          // только если уйти из секции и вернуться.
          const FULL_MS = SHOT_MS * SHOTS;
          const stage = sec.querySelector<HTMLElement>('.xp-stage')!;
          const cursorLabel = document.querySelector<HTMLElement>('.cursor-label');
          let play = 0, playT0 = 0, autoDone = false, lastY = scrollY;
          const setHint = (playing: boolean) => {
            hintEl.textContent = playing ? 'пробел — пауза · колесо — листать самому' : HINT;
            const atEnd = !playing && scroller.getBoundingClientRect().bottom <= innerHeight + 2;
            stage.dataset.cursor = playing ? 'Пробел — пауза' : atEnd ? 'Листайте ↓' : 'Пробел — дальше';
            // подпись курсора обновляется на движении мыши; если мышь стоит над сценой — меняем сразу
            if (cursorLabel && stage.matches(':hover')) cursorLabel.textContent = stage.dataset.cursor;
          };
          const pinned = (r = scroller.getBoundingClientRect()) => r.top <= 1 && r.bottom >= innerHeight - 1;
          const stop = () => {
            if (!play) return;
            cancelAnimationFrame(play);
            play = 0;
            delete document.documentElement.dataset.autoplay;
            setHint(false);
          };
          const start = () => {
            const from = scrollY;
            const to = scroller.getBoundingClientRect().top + scrollY + total;
            if (to - from < 2) return false;
            const dur = Math.max(600, (FULL_MS * (to - from)) / total);
            playT0 = performance.now();
            // инерционный скролл (Lenis) на время автопрокрутки отдаёт колесо странице и гасит свой разгон
            document.documentElement.dataset.autoplay = '';
            (window as unknown as { lenis?: { scrollTo: (t: number, o: object) => void } }).lenis?.scrollTo(from, { immediate: true, force: true });
            setHint(true);
            const step = (now: number) => {
              const k = Math.min(1, (now - playT0) / dur);
              // ровная скорость с коротким разгоном и торможением по краям (3% пути),
              // чтобы в середине таймлайна кадры не пролетали вдвое быстрее
              const A = 0.03, D = 2 * A * (1 - A);
              const e = k < A ? (k * k) / D : k > 1 - A ? 1 - ((1 - k) * (1 - k)) / D : (k - A / 2) / (1 - A);
              scrollTo({ top: from + (to - from) * e, behavior: 'instant' });
              if (k < 1) play = requestAnimationFrame(step);
              else stop();
            };
            play = requestAnimationFrame(step);
            return true;
          };
          // вызывается из frame(): запуск при входе в сцену сверху, сброс — когда секция ушла с экрана
          const autoCheck = (r: DOMRect, p: number) => {
            const down = scrollY > lastY;
            lastY = scrollY;
            if (r.bottom < 0 || r.top > innerHeight) autoDone = false;
            else if (!autoDone && !play && down && pinned(r) && p < 0.5) {
              autoDone = true;
              start();
            }
          };
          // инерция колеса/тачпада, которая докатила до сцены, не должна сразу гасить автоплей
          const onWheel = (e: WheelEvent) => {
            if (play && (e.deltaY < 0 || performance.now() - playT0 > 700)) stop();
          };
          const onKey = (e: KeyboardEvent) => {
            if (e.code !== 'Space') {
              if (play && /^(Arrow|Page|Home|End)/.test(e.key)) stop();
              return;
            }
            if (e.shiftKey || e.ctrlKey || e.metaKey || e.altKey) return;
            if ((e.target as HTMLElement).closest('input, textarea, select, button, a, [contenteditable], dialog')) return;
            if (play) {
              e.preventDefault();
              stop();
            } else if (pinned() && start()) {
              e.preventDefault();
            }
          };
          const onResize = () => {
            measure();
            request();
          };

          const enable = () => {
            if (on) return;
            on = true;
            sec.classList.add('xp-on');
            setHint(false);
            activeKey = '';
            doneCount = 0;
            rvReset();
            measure();
            frame();
            addEventListener('scroll', request, { passive: true });
            addEventListener('resize', onResize, { passive: true });
            addEventListener('keydown', onKey);
            addEventListener('wheel', onWheel, { passive: true });
            addEventListener('touchstart', stop, { passive: true });
            addEventListener('pointerdown', stop, { passive: true });
          };

          const disable = () => {
            if (!on) return;
            on = false;
            sec.classList.remove('xp-on');
            delete stage.dataset.cursor;
            removeEventListener('scroll', request);
            removeEventListener('resize', onResize);
            removeEventListener('keydown', onKey);
            removeEventListener('wheel', onWheel);
            removeEventListener('touchstart', stop);
            removeEventListener('pointerdown', stop);
            stop();
            cancelAnimationFrame(raf);
            raf = 0;
            [...jobs, ...clips, ...layers].forEach((el) => el.classList.remove('is-active', 'is-on', 'is-lead'));
            keys.forEach((k) => k.el.classList.remove('is-done'));
            rvReset();
            tracks.style.transform = '';
            scroller.style.height = '';
          };

          const sync = () => (mq.matches ? enable() : disable());
          mq.addEventListener('change', sync);
          // окно появилось или исчезло: перерисовать карточки и кадр без анимации
          wideMq.addEventListener('change', () => {
            if (!on) return;
            activeKey = '';
            rvReset();
            request();
          });
          sync();
        }
      }

      const dialog = document.querySelector<HTMLDialogElement>('dialog.reel')!;
      const player = dialog.querySelector('video')!;
      const openReel = () => {
        if (!player.src) player.src = player.dataset.src!;
        dialog.showModal();
        player.play().catch(() => {});
      };
      document.querySelector('[data-open-reel]')?.addEventListener('click', openReel);
      // На первом экране курсор — кнопка плей: клик по любому месту, кроме ссылок, кнопок и выделенного текста, открывает шоурил
      document.querySelector('.hero')?.addEventListener('click', (e) => {
        if ((e.target as Element).closest('a, button') || String(getSelection() ?? '')) return;
        openReel();
      });
      const close = () => dialog.close();
      dialog.querySelector('[data-close-reel]')?.addEventListener('click', close);
      dialog.addEventListener('click', (e) => e.target === dialog && close());
      dialog.addEventListener('close', () => player.pause());
    </script>
    <script>
      // Логотип: кроме автоповтора раз в 9 секунд, анимация запускается сразу при наведении и по тапу.
      // Все части (буквы и указатель кадра) переводятся в момент начала переворота; задержки букв
      // сохраняются, поэтому они по-прежнему переворачиваются по очереди.
      const logo = document.querySelector<HTMLElement>('.logo');
      const CYCLE = 9000;
      const FLIP_AT = CYCLE * 0.4; // в keyframes переворот начинается на 40%
      if (logo && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
        const parts = () =>
          logo.getAnimations({ subtree: true }).filter((a) => (a as CSSAnimation).animationName?.startsWith('lg-'));
        const play = () => {
          const anims = parts();
          if (!anims.length) return;
          const t = Number(anims[0].currentTime ?? 0) % CYCLE;
          if (t >= FLIP_AT - 100) return; // уже идёт — не дёргаем на середине
          anims.forEach((a) => (a.currentTime = FLIP_AT));
        };
        logo.addEventListener('pointerenter', (e) => {
          if (e.pointerType === 'mouse') play();
        });
        logo.addEventListener('pointerdown', play);
      }
    </script>
    <script>
      // Заголовки и текст: под курсором в буквах проявляется размытый зелёный эллипс, как в плашке меню.
      // Эллипс рисуется фоном, обрезанным по буквам (background-clip: text), поэтому фон вокруг текста не меняется.
      // Только для мыши и без reduced motion.
      const glowOk =
        matchMedia('(hover: hover) and (pointer: fine)').matches &&
        !matchMedia('(prefers-reduced-motion: reduce)').matches;
      if (glowOk) {
        const SEL = 'main h1, main h2, main h3, main p, main dd, footer p';
        const clear = 'rgba(0, 0, 0, 0)';
        const setPos = (el: HTMLElement, e: PointerEvent) => {
          const r = el.getBoundingClientRect();
          el.style.setProperty('--mx', `${e.clientX - r.left}px`);
          el.style.setProperty('--my', `${e.clientY - r.top}px`);
        };
        const timers = new WeakMap<HTMLElement, number>();
        document.addEventListener('pointerover', (e) => {
          const el = (e.target as Element).closest<HTMLElement>(SEL);
          if (!el || el.classList.contains('is-glow')) return;
          clearTimeout(timers.get(el));
          if (!el.classList.contains('text-glow')) {
            // элементы со своим фоном (кнопки, плашки) не трогаем: обрезка по тексту съела бы фон
            const cs = getComputedStyle(el);
            if (cs.backgroundImage !== 'none' || cs.backgroundColor !== clear) return;
            setPos(el, e);
            el.classList.add('text-glow');
            el.getBoundingClientRect(); // чтобы радиус вырос из нуля, а не появился сразу
          }
          el.classList.add('is-glow');
        });
        document.addEventListener('pointermove', (e) => {
          const el = (e.target as Element).closest<HTMLElement>('.text-glow');
          if (el) setPos(el, e);
        });
        document.addEventListener('pointerout', (e) => {
          const el = (e.target as Element).closest<HTMLElement>('.is-glow');
          if (!el || (e.relatedTarget instanceof Node && el.contains(e.relatedTarget))) return;
          el.classList.remove('is-glow');
          // после затухания (0,45 с) возвращаем элементу обычный вид
          timers.set(
            el,
            window.setTimeout(() => {
              if (!el.classList.contains('is-glow')) el.classList.remove('text-glow');
            }, 500),
          );
        });
      }
    </script>
    <script>
      // Фото «Обо мне»: под курсором фото темнеет ровным кругом (CSS) и проступает лаймовый 3D-каркас лица —
      // рёбра модели, сделанной по этому фото. Модель лежит точно поверх снимка, само фото не двигается.
      // Только для мыши и без reduced motion.
      import { Renderer, Camera, Transform, Program, Geometry, Mesh } from 'ogl';

      const wrap = document.querySelector<HTMLElement>('.photo-wrap');
      const canvas = wrap?.querySelector<HTMLCanvasElement>('.photo-3d');
      const meshOk =
        matchMedia('(hover: hover) and (pointer: fine)').matches &&
        !matchMedia('(prefers-reduced-motion: reduce)').matches;
      if (wrap && canvas && meshOk) initWire(wrap, canvas).catch(() => {});

      async function initWire(wrap: HTMLElement, canvas: HTMLCanvasElement) {
        let renderer: Renderer;
        try {
          renderer = new Renderer({ canvas, alpha: true, antialias: true, dpr: Math.min(devicePixelRatio || 1, 2), premultipliedAlpha: false });
        } catch {
          return;
        }
        const gl = renderer.gl;
        gl.clearColor(0, 0, 0, 0);

        // кадр фото в координатах модели (найден подгонкой рендера модели к artur.jpg). Низ кадра — по срезу бюста:
        // фото увеличено на 1.79% от верхнего края (.photo), полоска снизу, куда модель не доходит, обрезана
        const camera = new Camera(gl, { left: -0.43585, right: 0.39905, bottom: 0.002, top: 0.8369, near: 0.1, far: 10 });
        camera.position.set(0, 0, 3);
        const scene = new Transform();

        // bust_wire.bin: uint32 вершин, рёбер, треугольников; float32 позиции и нормали; uint16 рёбра и треугольники
        const bin = await (await fetch('/models/bust_wire.bin')).arrayBuffer();
        const [nv, ne, nt] = new Uint32Array(bin, 0, 3);
        const o = 12, pos = new Float32Array(bin, o, nv * 3), nrm = new Float32Array(bin, o + nv * 12, nv * 3);
        const eo = o + nv * 24, to = eo + ne * 4;
        const allEdges = new Uint16Array(bin, eo, ne * 2);
        const tris = new Uint16Array(bin.slice(to, to + nt * 6));
        // нижний срез модели (плоское дно бюста) не рисуем — иначе внизу видна горизонтальная граница
        const low = (i: number) => pos[i * 3 + 1] < 0.02;
        const kept: number[] = [];
        for (let i = 0; i < ne; i++) {
          const a = allEdges[i * 2], b = allEdges[i * 2 + 1];
          if (!(low(a) && low(b))) kept.push(a, b);
        }

        const uniforms = { uMouse: { value: [0, 0] }, uLensR: { value: 1 }, uLens: { value: 0 } };
        const lensGlsl = /* glsl */ `
          uniform vec2 uMouse;
          uniform float uLensR;
          uniform float uLens;
          float lensAt(vec2 p) { return uLens * (1.0 - smoothstep(uLensR * 0.55, uLensR, distance(p, uMouse))); }`;
        const vertex = (lift: string) => /* glsl */ `
          attribute vec3 position;
          attribute vec3 normal;
          uniform mat4 modelViewMatrix;
          uniform mat4 projectionMatrix;
          varying float vY;
          void main() {
            vY = position.y;
            gl_Position = projectionMatrix * modelViewMatrix * vec4(position + normal * ${lift}, 1.0);
          }`;

        // 2) невидимый слепок: только глубина, чтобы задние рёбра не просвечивали сквозь лицо
        const shell = new Mesh(gl, {
          geometry: new Geometry(gl, {
            position: { size: 3, data: pos },
            normal: { size: 3, data: nrm },
            index: { data: tris },
          }),
          program: new Program(gl, {
            vertex: vertex('0.0'),
            fragment: /* glsl */ `
              precision highp float;
              void main() { gl_FragColor = vec4(0.0); }`,
            transparent: true,
            cullFace: false,
          }),
        });
        shell.renderOrder = -1;
        // 3) рёбра модели — как wireframe в Blender, лаймом
        const wire = new Mesh(gl, {
          geometry: new Geometry(gl, {
            position: { size: 3, data: pos },
            normal: { size: 3, data: nrm },
            index: { data: new Uint16Array(kept) },
          }),
          mode: gl.LINES,
          program: new Program(gl, {
            vertex: vertex('0.004'),
            fragment: /* glsl */ `
              precision highp float;
              ${lensGlsl}
              varying float vY;
              void main() {
                float a = lensAt(gl_FragCoord.xy);
                if (a < 0.01) discard;
                gl_FragColor = vec4(0.83, 1.0, 0.23, a);
              }`,
            uniforms,
            transparent: true,
            depthWrite: false,
          }),
        });
        wire.renderOrder = 1;
        for (const m of [shell, wire]) m.setParent(scene);

        // lens — раскрытие 0..1, lx/ly — курсор в пикселях канваса (низ = 0), всё с плавной доводкой
        let lens = 0, lensTo = 0, lx = 0, ly = 0, lxTo = 0, lyTo = 0, raf = 0;
        const frame = () => {
          raf = 0;
          lens += (lensTo - lens) * 0.12;
          lx += (lxTo - lx) * 0.2;
          ly += (lyTo - ly) * 0.2;
          uniforms.uLens.value = lens;
          uniforms.uMouse.value = [lx, ly];
          uniforms.uLensR.value = gl.canvas.height * 0.34 * (0.35 + 0.65 * lens);
          // затемнение фото — CSS-градиент под канвасом (.photo-wrap::after), ровный круг того же размера
          const dpr = renderer.dpr;
          wrap.style.setProperty('--lx', `${lx / dpr}px`);
          wrap.style.setProperty('--ly', `${wrap.clientHeight - ly / dpr}px`);
          wrap.style.setProperty('--lr', `${uniforms.uLensR.value / dpr}px`);
          wrap.style.setProperty('--lo', lens.toFixed(3));
          renderer.render({ scene, camera });
          if (Math.abs(lensTo - lens) > 0.003 || (lens > 0.003 && Math.abs(lxTo - lx) + Math.abs(lyTo - ly) > 0.5))
            raf = requestAnimationFrame(frame);
        };
        const kick = () => (raf ||= requestAnimationFrame(frame));
        const at = (e: PointerEvent) => {
          const r = wrap.getBoundingClientRect(), dpr = renderer.dpr;
          lxTo = (e.clientX - r.left) * dpr;
          lyTo = (r.bottom - e.clientY) * dpr;
        };
        wrap.addEventListener('pointerenter', (e) => {
          at(e);
          lx = lxTo;
          ly = lyTo;
          lensTo = 1;
          kick();
        });
        wrap.addEventListener('pointermove', (e) => {
          at(e);
          kick();
        });
        wrap.addEventListener('pointerleave', () => {
          lensTo = 0;
          kick();
        });
        new ResizeObserver(() => {
          renderer.setSize(wrap.clientWidth, wrap.clientHeight);
          kick();
        }).observe(wrap);
      }
    </script>
    <script>
      // «Обо мне», цифры (14 лет, 17 000+, 30+): собираются из лаймовых точек, как точки фона сайта.
      // Точки слетаются в форму цифры, потом плавно сменяются обычным текстом. Наведение — собрать заново.
      // Текст всегда в разметке (поиск, экранные дикторы); при reduced motion эффекта нет.
      if (!matchMedia('(prefers-reduced-motion: reduce)').matches) {
        const PAD = 48; // запас канваса вокруг цифры: оттуда прилетают точки
        const STEP = 3.2, R = 1.15; // шаг сетки точек и радиус точки, css px
        type Dot = { x: number; y: number; sx: number; sy: number; d: number };

        const setup = (dt: HTMLElement) => {
          const canvas = document.createElement('canvas');
          canvas.className = 'fact-dots';
          canvas.setAttribute('aria-hidden', 'true');
          dt.append(canvas);
          const ctx = canvas.getContext('2d')!;
          let dots: Dot[] = [], w = 0, h = 0, dpr = 1, raf = 0, t0 = 0;

          // точки — пиксели цифры, отрисованной тем же шрифтом, что и текст
          const sample = () => {
            const cs = getComputedStyle(dt);
            dpr = Math.min(devicePixelRatio || 1, 2);
            const bw = dt.clientWidth, bh = dt.clientHeight;
            w = bw + PAD * 2;
            h = bh + PAD * 2;
            canvas.width = w * dpr;
            canvas.height = h * dpr;
            const text = dt.firstChild?.textContent?.trim() ?? '';
            const off = document.createElement('canvas');
            off.width = w;
            off.height = h;
            const g = off.getContext('2d', { willReadFrequently: true })!;
            g.font = `${cs.fontWeight} ${cs.fontSize} ${cs.fontFamily}`;
            if ('letterSpacing' in g) (g as CanvasRenderingContext2D & { letterSpacing: string }).letterSpacing = cs.letterSpacing;
            const m = g.measureText(text);
            const lh = parseFloat(cs.lineHeight) || parseFloat(cs.fontSize);
            const base = (lh - (m.fontBoundingBoxAscent + m.fontBoundingBoxDescent)) / 2 + m.fontBoundingBoxAscent;
            g.fillText(text, PAD, PAD + base);
            const px = g.getImageData(0, 0, w, h).data;
            dots = [];
            for (let y = 0; y < h; y += STEP)
              for (let x = 0; x < w; x += STEP) {
                if (px[((Math.round(y) * w + Math.round(x)) << 2) + 3] < 140) continue;
                const a = Math.random() * Math.PI * 2, r = 20 + Math.random() * 60;
                dots.push({ x, y, sx: x + Math.cos(a) * r * 1.6, sy: y + Math.sin(a) * r, d: Math.random() * 0.35 });
              }
          };

          const DUR = 1500;
          const frame = (now: number) => {
            const p = (now - t0) / DUR;
            ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
            ctx.clearRect(0, 0, w, h);
            ctx.fillStyle = '#d4ff3a';
            for (const o of dots) {
              const k = Math.min(1, Math.max(0, (p - o.d) / (1 - 0.35)));
              const e = 1 - (1 - k) ** 3;
              ctx.globalAlpha = Math.min(1, k * 3);
              ctx.beginPath();
              ctx.arc(o.sx + (o.x - o.sx) * e, o.sy + (o.y - o.sy) * e, R, 0, Math.PI * 2);
              ctx.fill();
            }
            if (p < 1) raf = requestAnimationFrame(frame);
            else {
              raf = 0;
              dt.classList.remove('is-dots'); // точки собрались — проявляется настоящий текст, точки гаснут
            }
          };
          const play = () => {
            if (raf) return;
            sample();
            dt.classList.add('is-dots');
            t0 = performance.now();
            raf = requestAnimationFrame(frame);
          };
          return play;
        };

        const facts = [...document.querySelectorAll<HTMLElement>('.facts > div')];
        const players = new Map<Element, () => void>();
        document.fonts.ready.then(() => {
          facts.forEach((div) => {
            const dt = div.querySelector<HTMLElement>('dt');
            if (!dt) return;
            dt.classList.add('is-dots');
            const play = setup(dt);
            players.set(div, play);
            div.addEventListener('pointerenter', (e) => e.pointerType === 'mouse' && play());
          });
          const io = new IntersectionObserver(
            (entries) =>
              entries.forEach((e) => {
                if (!e.isIntersecting) return;
                io.unobserve(e.target);
                setTimeout(players.get(e.target)!, facts.indexOf(e.target as HTMLElement) * 180 + 250);
              }),
            { threshold: 0.6 },
          );
          facts.forEach((div) => io.observe(div));
        });
      }
    </script>
  </body>
</html>
