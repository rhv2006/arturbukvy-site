---
import '@fontsource-variable/unbounded';
import '@fontsource-variable/manrope';
import '../styles/global.css';
import { getCases } from '../lib/behance';
import experience from '../data/experience.json';
import { xpFrames } from '../data/xp-frames';
import { getArticles } from '../lib/teletype';
import WorkGallery from '../components/WorkGallery.astro';
import Contact from '../components/Contact.astro';
import Cursor from '../components/Cursor.astro';
import SmoothScroll from '../components/SmoothScroll.astro';

const [{ top, rest, tail }, articles] = await Promise.all([getCases(), getArticles()]);

const site = {
  name: 'Артур Фаттахов',
  role: '3D, motion и key visual',
  telegram: 'https://t.me/Arturbukvi',
  telegramLabel: '@Arturbukvi',
  email: 'rhv2006@gmail.com',
  hh: 'https://hh.ru/resume/d357baebff014567e30039ed1f66587939394b',
  behance: 'https://www.behance.net/rhv2006',
  automation: 'https://teletype.in/@rhv2006',
  reelVimeo: 'https://vimeo.com/1218208289',
  resumePdf: '/fattakhov-resume.pdf',
  resumePdfEn: '/fattakhov-resume-en.pdf',
};

const description =
  'Артур Фаттахов — дизайнер 3D, motion и key visual. 14 лет опыта, кейсы для Альфа-Банка, МТС, t2, ОТП Банка и Касперского.';

const facts = [
  { value: '14 лет', label: 'в дизайне: от препресса до CGI-роликов' },
  { value: '17 000+', label: 'экранов t2 по России крутят мои 20+ роликов' },
  { value: '30+', label: '3D key visual для промо приложения Альфа-Банка' },
];

const tools = ['Cinema 4D', 'Redshift', 'Octane', 'Blender', 'Unreal Engine 5', 'TouchDesigner', 'Adobe After Effects', 'Adobe Photoshop', 'Adobe Illustrator', 'Adobe InDesign', 'Figma'];
const ai = ['Veo 3.1', 'Kling 3.0', 'Sora 2 Pro', 'Seedance', 'Flux 2 Pro', 'Nano Banana Pro', 'Midjourney', 'Recraft', 'Reve', 'ComfyUI', 'Freepik', 'Google Flow', 'Higgsfield'];

// Опыт: данные в src/data/experience.json, самое свежее сверху.
// Таймлайн на десктопе рисуется из тех же данных: годы → позиции клипов и кейфреймов на дорожках.
const TL_FROM = 2011;
const TL_TO = 2027;
// метки слоёв — оттенки лаймового акцента сайта
const LAYER_COLORS = ['#d4ff3a', '#b2dc2c', '#8fb822', '#6e9419', '#f2f0eb'];
const ym = (s: string, end = false) => {
  const [y, m] = s.split('-').map(Number);
  return y + (end ? m : m - 1) / 12;
};
const timeline = experience.map((job, i) => {
  const from = ym(job.from);
  const to = ym(job.to, true);
  const n = job.points.length;
  return {
    ...job,
    start: +from.toFixed(4),
    end: +to.toFixed(4),
    color: LAYER_COLORS[i % LAYER_COLORS.length],
    keys: job.points.map((_, k) => +(from + ((to - from) * (k + 1)) / (n + 1)).toFixed(4)),
  };
});
const tlYears = Array.from({ length: TL_TO - TL_FROM + 1 }, (_, i) => TL_FROM + i);
// Кадры окна Render View (src/data/xp-frames.ts): по возрастанию года, нумерация «кадр n / N» — внутри работы
const frames = [...xpFrames]
  .sort((a, b) => a.year - b.year)
  .map((f, _, all) => {
    const same = all.filter((g) => g.job === f.job);
    return { ...f, n: same.indexOf(f) + 1, total: same.length };
  });
const framesOf = (layer: string) => frames.filter((f) => f.job === layer);

const dateRu = (iso: string) =>
  new Date(iso).toLocaleDateString('ru-RU', { day: 'numeric', month: 'long', year: 'numeric' });
---

<!doctype html>
<html lang="ru">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="dark" />
    <meta name="theme-color" content="#0b0b0d" />
    <title>{site.name} — {site.role}</title>
    <meta name="description" content={description} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="canonical" href={Astro.site} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={`${site.name} — ${site.role}`} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL('/og.jpg?v=2', Astro.site)} />
    <meta property="og:url" content={Astro.site} />
    <meta property="og:locale" content="ru_RU" />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="preconnect" href="https://mir-s3-cdn-cf.behance.net" />
    <!-- Yandex.Metrika counter -->
    <script is:inline type="text/javascript">
      (function(m,e,t,r,i,k,a){
          m[i]=m[i]||function(){(m[i].a=m[i].a||[]).push(arguments)};
          m[i].l=1*new Date();
          for (var j = 0; j < document.scripts.length; j++) {if (document.scripts[j].src === r) { return; }}
          k=e.createElement(t),a=e.getElementsByTagName(t)[0],k.async=1,k.src=r,a.parentNode.insertBefore(k,a)
      })(window, document,'script','https://mc.yandex.ru/metrika/tag.js?id=114661416', 'ym');

      ym(114661416, 'init', {ssr:true, webvisor:true, clickmap:true, ecommerce:"dataLayer", referrer: document.referrer, url: location.href, accurateTrackBounce:true, trackLinks:true});
    </script>
    <!-- /Yandex.Metrika counter -->
  </head>
  <body>
    <noscript><div><img src="https://mc.yandex.ru/watch/114661416" style="position:absolute; left:-9999px;" alt="" /></div></noscript>
    <header class="topbar">
      <div class="topbar-pill">
        <span class="pill-glow" aria-hidden="true"></span>
        <a class="logo" href="#top" aria-label="артурбуквы">
          <span class="lg" aria-hidden="true">
            {
              [...'артурбуквы'].map((ch, i, all) => (
                <span class:list={['lg-l', { 'lg-first': i === 0, 'lg-last': i === all.length - 1 }]} style={`--i:${i}`}>
                  <span class="lg-sizer">{ch}</span>
