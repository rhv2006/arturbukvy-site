---
// Полоса прокрутки в виде плейхеда After Effects: справа линейка кадров, зелёная головка с таймкодом.
// Тянется мышью, клик по линейке перескакивает. Только на устройствах с мышью: там системная полоса скрыта
// (класс has-scrubber на <html>), на тач-экранах остаётся родная.
---

<div class="scrub" data-scrub aria-hidden="true">
  <div class="scrub-ruler"></div>
  <div class="scrub-played"></div>
  <div class="scrub-head">
    <span class="scrub-tc">0:00:00:00</span>
  </div>
</div>

<style>
  .scrub {
    display: none;
  }
  :global(html.has-scrubber) .scrub {
    position: fixed;
    top: 96px;
    bottom: 24px;
    right: 0;
    z-index: 45;
    display: block;
    width: 22px;
    cursor: ns-resize;
    touch-action: none;
    user-select: none;
  }
  /* страница не прокручивается — полосы нет */
  :global(html.has-scrubber) .scrub.is-off {
    display: none;
  }

  /* линейка: мелкие засечки каждые 8px, длинные каждые 40px */
  .scrub-ruler {
    position: absolute;
    inset: 0 0 0 auto;
    width: 12px;
    background:
      repeating-linear-gradient(to bottom, var(--muted) 0 1px, transparent 1px 40px) right / 12px 100% no-repeat,
      repeating-linear-gradient(to bottom, var(--line) 0 1px, transparent 1px 8px) right / 6px 100% no-repeat;
    opacity: 0.55;
    transition: opacity 0.25s;
  }
  .scrub:hover .scrub-ruler,
  .scrub.is-drag .scrub-ruler {
    opacity: 1;
  }

  /* пройденная часть — как рабочая область в AE */
  .scrub-played {
    position: absolute;
    top: 0;
    right: 13px;
    width: 1px;
    height: calc(var(--p, 0) * 100%);
    background: color-mix(in srgb, var(--accent) 45%, transparent);
  }

  .scrub-head {
    position: absolute;
    left: 0;
    right: 0;
    top: calc(var(--p, 0) * 100%);
    height: 0;
  }
  /* линия плейхеда поперёк линейки */
  .scrub-head::before {
    content: '';
    position: absolute;
    right: 0;
    top: -2px;
    width: 22px;
    height: 4px;
    border-radius: 999px 0 0 999px;
    background: var(--accent);
  }
  /* таймкод рядом с головкой: виден при прокрутке, наведении и перетаскивании */
  .scrub-tc {
    position: absolute;
    right: 28px;
    top: -11px;
    padding: 5px 7px;
    border-radius: 4px;
    background: var(--accent);
    color: var(--accent-ink);
    font: 600 11px/1 var(--display);
    font-variant-numeric: tabular-nums;
    letter-spacing: 0.04em;
    white-space: nowrap;
    opacity: 0;
    translate: 6px 0;
    transition:
      opacity 0.25s,
      translate 0.25s;
    pointer-events: none;
  }
  .scrub:hover .scrub-tc,
  .scrub.is-drag .scrub-tc,
  .scrub.is-moving .scrub-tc {
    opacity: 1;
    translate: 0 0;
  }

  /* системную полосу прячем, только когда наша на месте */
  :global(html.has-scrubber) {
    scrollbar-width: none;
  }
  :global(html.has-scrubber::-webkit-scrollbar) {
    display: none;
  }
</style>

<script>
  const el = document.querySelector<HTMLElement>('[data-scrub]');
  if (el && matchMedia('(hover: hover) and (pointer: fine)').matches) {
    const root = document.documentElement;
    root.classList.add('has-scrubber');
    const tc = el.querySelector<HTMLElement>('.scrub-tc')!;
    const FPS = 25,
      TOTAL = 60 * FPS; // весь сайт — минутный ролик, как и таймкод в «Обо мне»
    const p2 = (n: number) => String(n).padStart(2, '0');
    const maxScroll = () => root.scrollHeight - innerHeight;
    type L = { scrollTo: (y: number, o?: object) => void };
    const lenis = () => (window as unknown as { lenis?: L }).lenis;

    let queued = false,
      idle = 0;
    const draw = () => {
      queued = false;
      const max = maxScroll();
      el.classList.toggle('is-off', max < 8);
      const p = max > 0 ? Math.min(1, Math.max(0, scrollY / max)) : 0;
      el.style.setProperty('--p', p.toFixed(4));
      const f = Math.round(p * TOTAL),
        s = Math.floor(f / FPS);
      tc.textContent = `0:${p2(Math.floor(s / 60))}:${p2(s % 60)}:${p2(f % FPS)}`;
    };
    const queue = () => {
      if (!queued) {
        queued = true;
        requestAnimationFrame(draw);
      }
    };
    addEventListener(
      'scroll',
      () => {
        queue();
        el.classList.add('is-moving');
        clearTimeout(idle);
        idle = window.setTimeout(() => el.classList.remove('is-moving'), 900);
      },
      { passive: true },
    );
    addEventListener('resize', queue);
    new ResizeObserver(queue).observe(document.body);
    draw();

    // перетаскивание и клик: позиция курсора на линейке → место на странице
    const seek = (clientY: number, smooth: boolean) => {
      const r = el.getBoundingClientRect();
      const y = Math.min(1, Math.max(0, (clientY - r.top) / r.height)) * maxScroll();
      const l = lenis();
      if (l) l.scrollTo(y, smooth ? { duration: 0.8 } : { immediate: true, force: true });
      else scrollTo({ top: y, behavior: smooth ? 'smooth' : 'instant' });
    };
    let dragging = false,
      downY = 0;
    el.addEventListener('pointerdown', (e) => {
      if (e.button !== 0) return;
      e.preventDefault();
      dragging = false;
      downY = e.clientY;
      el.setPointerCapture(e.pointerId);
      el.classList.add('is-drag');
    });
    el.addEventListener('pointermove', (e) => {
      if (!el.hasPointerCapture(e.pointerId)) return;
      if (!dragging && Math.abs(e.clientY - downY) < 3) return;
      dragging = true;
      seek(e.clientY, false);
    });
    const up = (e: PointerEvent) => {
      if (!el.hasPointerCapture(e.pointerId)) return;
      el.releasePointerCapture(e.pointerId);
      el.classList.remove('is-drag');
      if (!dragging) seek(e.clientY, true); // простой клик — плавно доезжаем
    };
    el.addEventListener('pointerup', up);
    el.addEventListener('pointercancel', up);
  }
</script>
